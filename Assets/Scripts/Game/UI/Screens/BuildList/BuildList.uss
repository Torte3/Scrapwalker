.build-band {
    position: absolute;
    left: 352px;
    right: 0;
    bottom: 0;
    height: var(--bottom-height);
    padding: 12px 14px;
    border-top-width: 1px;
    border-top-color: var(--c-line);
}

.build-list {
    flex-grow: 1;
}

.build-list__head {
    flex-direction: row;
    flex-shrink: 0;
    height: 19px;
    margin-bottom: 4px;
}

.build-list__tabs {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
}

.build-list__tab {
    width: 116px;
    height: 19px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    --btn-edge: var(--c-line);
    color: var(--c-dim);
}

.build-list__tab-label {
    font-size: 13px;
}

.build-list__page {
    width: 60px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--c-dim);
    -unity-text-align: middle-right;
}

.build-list__main {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.build-list__turn {
    width: 40px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    --btn-edge: var(--c-line);
}

.build-list__turn-icon {
    width: 10px;
    height: 10px;
}

.btn.build-list__turn.btn--unusable.btn--unusable {
    --btn-edge: var(--c-bar-border);
    background-color: rgba(0, 0, 0, 0);
}

.btn.build-list__turn.btn--unusable.btn--unusable > .icon {
    -unity-background-image-tint-color: var(--c-bar-border);
}

.build-list__cards {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: stretch;
    margin: 0 8px;
    overflow: hidden;
}

.build-list__card {
    width: 270px;
    flex-shrink: 0;
    margin-right: 8px;
}

.build-card {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    margin: 0;
    padding: 5px 9px 5px 7px;
    border-width: 1px;
    border-radius: 3px;
    --btn-edge: var(--c-line);
    border-color: var(--btn-edge);
    background-color: rgba(255, 255, 255, 0.02);
    color: var(--c-text);
    -unity-text-align: upper-left;
}

.build-card--blocked {
    opacity: 0.45;
}

.build-card--chosen {
    --btn-edge: var(--c-amber);
}

.build-card__ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1px;
    border-radius: 2px;
    border-color: var(--c-amber);
}

.build-card__thumb-area {
    width: 70px;
    flex-shrink: 0;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
}

.build-card__thumb {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
}

.build-card__body {
    flex-grow: 1;
    flex-basis: 0;
}

.build-card__head {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 18px;
    margin-bottom: 3px;
}

.build-card__name {
    flex-grow: 1;
    flex-basis: 0;
    overflow: hidden;
    font-size: 14px;
    -unity-font-style: bold;
}

.build-card__size {
    width: 52px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--c-dim);
    -unity-text-align: middle-right;
}

.build-card__line {
    flex-shrink: 0;
    justify-content: center;
    height: 17px;
    margin-bottom: 1px;
}

.build-card__line .mat {
    margin-bottom: 0;
}

.build-tape__edge {
    position: absolute;
    background-image: url("/Assets/Art/UI/tape.png");
    background-repeat: repeat repeat;
    background-size: 28px 28px;
}

.build-tape__edge--top {
    background-position-x: 8.7px;
    left: 0;
    right: 0;
    top: var(--top-height);
    height: 9px;
}

.build-tape__edge--bottom {
    background-position-x: 10.3px;
    left: 0;
    right: 0;
    bottom: var(--bottom-height);
    height: 9px;
}

.build-tape__edge--left {
    background-position-x: 4px;
    left: 0;
    top: var(--top-height);
    bottom: var(--bottom-height);
    width: 9px;
}

.build-tape__edge--right {
    background-position-x: 4px;
    right: 0;
    top: var(--top-height);
    bottom: var(--bottom-height);
    width: 9px;
}
