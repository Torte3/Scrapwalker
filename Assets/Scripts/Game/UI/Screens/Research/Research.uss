.research-panel .window {
    width: 1504px;
    height: 682px;
}

.research-legends {
    flex-direction: row;
    align-items: center;
}

.research-legend {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    margin-right: 12px;
}

.research-legend__box {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    border-width: 1px;
    border-radius: 3px;
}

.research-legend__box--done { border-color: var(--c-ok); }
.research-legend__box--current { border-color: var(--c-amber); }
.research-legend__box--available { border-color: var(--c-cyan); }

.research-legend__label {
    font-size: 12.8px;
    color: var(--c-dim);
    -unity-text-align: middle-left;
}

.research-page {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-start;
}

.research-view {
    flex-grow: 1;
    align-self: stretch;
    border-width: 1px;
    border-radius: 3px;
    border-color: #222a25;
    background-color: #0c100e;
}

.research-port {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.research-tree {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
}

.research-lines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --line-color: #56625b;
    --line-done-color: #4f7a55;
    --line-lit-color: #ffffff;
    --line-width: 1.3;
    --lit-width: 2.2;
}

.research-nodes {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.research-node-slot {
    position: absolute;
    left: 0;
    top: 0;
}

.research-node {
    position: absolute;
}

.research-node__glow {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(232, 163, 61, 0.35);
    background-color: rgba(232, 163, 61, 0.08);
    display: none;
}

.research-node--status-current > .research-node__glow {
    display: flex;
}

.research-node__ring {
    position: absolute;
    left: -4px;
    top: -4px;
    right: -4px;
    bottom: -4px;
    border-width: 1px;
    border-radius: 3px;
    border-color: #ffffff;
    display: none;
}

.research-node--selected > .research-node__ring {
    display: flex;
}

.research-node__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--c-bar-border);
    background-color: #121815;
    overflow: hidden;
}

.research-node--status-done > .research-node__frame { border-color: var(--c-ok); }
.research-node--status-current > .research-node__frame { border-color: var(--c-amber); }
.research-node--status-available > .research-node__frame { border-color: var(--c-cyan); }
.research-node--status-locked > .research-node__frame { border-color: rgba(0, 0, 0, 0); }

.research-node__name {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 5px;
    height: 24px;
    font-size: 14.4px;
    -unity-font-style: bold;
    color: var(--c-text);
    overflow: hidden;
    text-overflow: ellipsis;
}

.research-node--status-done .research-node__name { color: var(--c-ok); }
.research-node--status-locked .research-node__name { color: #9aa79f; }

.research-node__picture {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 26px;
    bottom: 8px;
}

.research-picture__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.research-node__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
}

.research-node__bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background-color: var(--c-amber);
}

.research-node__dashed {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.research-node--status-locked > .research-node__dashed {
    display: flex;
}

.research-side {
    width: 336px;
    flex-shrink: 0;
    margin-left: 19px;
}

.research-card {
    flex-shrink: 0;
    padding: 13px 15px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--c-window-border);
}

.research-card > * {
    margin-bottom: 3px;
}

.research-card--detail {
    height: 356px;
}

.research-detail__none {
    display: none;
    white-space: normal;
}

.research-card--none > * {
    display: none;
}

.research-card--none > .research-detail__none {
    display: flex;
}

.research-card--now {
    height: 204px;
    margin-top: 13px;
}

.research-detail__head {
    flex-direction: row;
    height: 26px;
}

.research-detail__title {
    flex-grow: 1;
    flex-shrink: 1;
    height: 26px;
    font-size: 18.4px;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.research-detail__picture {
    flex-shrink: 0;
    width: 52px;
    height: 26px;
    margin-left: 8px;
}

.research-detail__status {
    height: 18px;
    font-size: 12px;
    color: var(--c-amber);
    overflow: hidden;
    text-overflow: ellipsis;
}

.research-sub {
    height: 22px;
    font-size: 12px;
    color: var(--c-dim);
    -unity-text-align: lower-left;
}

.research-sub--top {
    -unity-text-align: upper-left;
}

.research-pre {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.research-pre__tag {
    width: 98px;
    height: 22px;
    margin-right: 5px;
    padding: 0 4px;
    justify-content: center;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--c-bar-border);
}

.research-pre__text {
    font-size: 12.8px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
}

.research-pre__tag--done {
    border-color: var(--c-ok);
}

.research-pre__tag--done > .research-pre__text {
    color: var(--c-ok);
}

.research-unlocks {
    margin-top: 2px;
}

.research-unlock {
    flex-direction: row;
    align-items: center;
    height: 17px;
}

.research-unlock__kind {
    width: 34px;
    flex-shrink: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.research-unlock__kind--facility { color: var(--c-amber); }
.research-unlock__kind--task { color: var(--c-cyan); }
.research-unlock__kind--upgrade { color: var(--c-ok); }

.research-unlock__name,
.research-unlocks__none {
    flex-shrink: 1;
    font-size: 12.8px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.research-mats {
    margin-top: 4px;
}

.research-spacer {
    flex-grow: 1;
}

.research-act {
    height: 34px;
    margin-bottom: 0;
}

.research-act > Label {
    font-size: 15px;
    -unity-font-style: bold;
}

.research-now__row {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.research-now__name {
    width: 168px;
    margin-right: 6px;
    font-size: 14.4px;
    color: var(--c-amber);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.research-now__name--none {
    color: var(--c-dim);
}

.research-now__count {
    width: 130px;
    font-size: 14.4px;
    -unity-text-align: middle-right;
}

.research-now__bar {
    height: 8px;
}

.research-now__stop {
    height: 18px;
    font-size: 12.8px;
    overflow: hidden;
}

.research-cancel {
    height: 34px;
    margin-bottom: 0;
    --btn-edge: var(--c-line);
    background-color: rgba(0, 0, 0, 0);
}

.research-cancel > Label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--c-dim);
}

