<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="stock" class="stock side-stock-line" picking-mode="Ignore">
        <ui:Label name="stock-name" class="side-stock-line__name nowrap" picking-mode="Ignore" />
        <ui:Label name="stock-breakdown" class="side-stock-line__breakdown dim nowrap" picking-mode="Ignore" />
        <ui:Label name="stock-count" class="side-stock-line__count bold nowrap" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
