.top-bar {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: var(--top-height);
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-line);
}

.top-bar__cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 8px 16px;
    border-right-width: 1px;
    border-right-color: var(--c-line);
    overflow: hidden;
}

.top-bar__cell--row {
    flex-direction: row;
}

.top-bar__group {
    flex-direction: column;
    flex-shrink: 0;
}

.top-bar__group--next {
    margin-left: 24px;
}

.top-bar__head {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    flex-shrink: 0;
    height: 16px;
}

.top-bar__head-text {
    font-size: 12px;
}

.top-bar__hull-value {
    margin-left: 3px;
}

.top-bar__barrier-value {
    margin-left: 3px;
    flex-shrink: 0;
    color: var(--c-text);
}

.top-bar__barrier-value.top-bar__barrier-value--empty {
    color: var(--c-warn);
}

.top-bar__body {
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
    flex-shrink: 0;
    height: 20px;
    margin-top: 3px;
}

.top-bar__bar {
    width: 150px;
    height: 10px;
}

.top-bar__fill--amber {
    background-color: var(--c-amber);
}

.top-bar__fill--barrier {
    background-color: var(--c-barrier);
}

.top-bar__fill--cyan {
    background-color: var(--c-cyan);
}

.top-bar__ruin-name {
    font-size: 16px;
}

.top-bar__wave-title {
    flex-grow: 1;
    flex-shrink: 1;
}

.top-bar__wave-time {
    margin-left: 6px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.top-bar__seconds {
    margin-left: 3px;
    color: var(--c-cyan);
}

.top-bar__seconds.top-bar__seconds--boss {
    color: var(--c-boss);
}

.top-bar__squares {
    margin-left: -3px;
    flex-direction: row;
    flex-shrink: 0;
    height: 10px;
}

.top-bar__square {
    width: 26px;
    height: 10px;
    margin-left: 3px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--c-bar-border);
}

.top-bar__square-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 2px;
    background-color: var(--c-bar);
}

.top-bar__square--none {
    border-color: rgba(0, 0, 0, 0);
}

.top-bar__square--none > .top-bar__square-fill {
    background-color: rgba(0, 0, 0, 0);
}

.top-bar__square--done {
    border-color: var(--c-wave-done);
}

.top-bar__square--done > .top-bar__square-fill {
    background-color: var(--c-wave-done);
}

.top-bar__square--now {
    border-color: var(--c-amber);
}

.top-bar__square--now > .top-bar__square-fill {
    background-color: var(--c-amber);
}

.top-bar__square--last {
    border-color: var(--c-amber);
}

.top-bar__wave-gauge {
    margin-top: 3px;
    width: 180px;
    height: 3px;
}

.top-bar__wave-gauge-fill {
    background-color: var(--c-cyan);
}

.top-bar__wave-gauge--boss > .top-bar__wave-gauge-fill {
    background-color: var(--c-boss);
}

.top-bar__power-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.top-bar__power-value {
    margin-left: 3px;
    flex-shrink: 0;
    color: var(--c-text);
}

.top-bar__power-value.top-bar__power-value--empty {
    color: var(--c-warn);
}
