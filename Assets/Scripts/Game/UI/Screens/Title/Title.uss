.title__vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.title__column {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    padding-top: 192px;
}

.title__logo {
    width: 805px;
    height: 106px;
    margin-bottom: 202px;
    -unity-background-scale-mode: scale-to-fit;
}

.title .title__btn {
    width: 240px;
    height: 46px;
    margin-bottom: 12px;
    font-size: 18px;
    background-color: var(--c-panel-fill);
}
