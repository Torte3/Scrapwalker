<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="LootView" src="../../Widgets/LootView.uxml" />
    <ui:VisualElement class="ticker-item invisible" picking-mode="Ignore">
        <ui:VisualElement class="ticker-item__mark" picking-mode="Ignore" />
        <ui:Label name="text" class="ticker-item__text nowrap" picking-mode="Ignore" />
        <ui:VisualElement name="items" class="ticker-item__items" picking-mode="Ignore">
            <ui:Instance template="LootView" name="loot" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
