.quality-filter-icon {
    width: 124px;
    height: 30px;
    font-size: 12px;
}

.quality-filter-icon--open {
    --btn-edge: var(--c-amber);
}

.quality-filter-icon > .quality-filter-icon__funnel {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.quality-filter-icon__pips {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 78px;
    height: 14px;
}

.quality-filter-icon__pip {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin: 0 1px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--c-button-border);
}

.quality-filter-icon__pip--on {
    border-color: var(--c-amber);
    background-color: var(--c-amber);
}

.quality-filter-icon__pip > .quality-filter-icon__mark {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: auto;
    height: auto;
    -unity-background-image-tint-color: var(--c-window-fill);
}

.quality-filter {
    padding: 5px 7px 1px 7px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--c-line);
}

.quality-filter > * {
    margin-bottom: 6px;
}

.quality-filter__head {
    flex-direction: row;
    align-items: center;
}

.quality-filter__key {
    font-size: 12px;
    color: var(--c-dim);
}

.quality-filter__head > .quality-filter__key {
    margin-right: 8px;
}

.quality-filter__summary {
    flex-grow: 1;
    font-size: 12px;
}

.quality-range,
.quality-filter__ticks {
    flex-direction: row;
    margin-right: -3px;
}

.quality-range {
    height: 18px;
    padding: 2px 0;
}

.quality-range__cell {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 3px;
    background-color: var(--c-bar);
}

.quality-range__cell--on {
    background-color: var(--c-amber);
}

.quality-range__edge {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 4px;
    background-color: var(--c-bright);
}

.quality-range__edge--low {
    left: -2px;
}

.quality-range__edge--high {
    right: -2px;
}

.quality-filter__tick {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 3px;
    font-size: 11px;
    color: var(--c-dim);
    -unity-text-align: upper-center;
}

.quality-filter__order {
    flex-direction: row;
}

.quality-filter__order-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 30px;
    font-size: 12px;
    -unity-font-style: bold;
}

.quality-filter__order-button--low {
    margin-right: 6px;
}

.quality-filter__order-button > .quality-filter__order-icon {
    width: 10px;
    height: 10px;
}
