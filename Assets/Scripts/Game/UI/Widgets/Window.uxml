<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Corners" src="Corners.uxml" />
    <Style src="Window.uss" />
    <ui:VisualElement name="window-layer" class="window-layer" picking-mode="Ignore">
        <ui:VisualElement name="backdrop" class="window-backdrop" />
        <ui:VisualElement name="frame" class="window">
            <ui:Instance template="Corners" class="corners-host window__corners" picking-mode="Ignore" />
            <ui:VisualElement name="head" class="window__head">
                <ui:Label name="title" class="window__title" />
                <ui:VisualElement name="head-extra" class="window__head-extra hidden" />
                <ui:Button name="close" class="btn window__close">
                    <ui:VisualElement class="icon icon--close window__close-icon" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="body" class="window__body" content-container="body" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
