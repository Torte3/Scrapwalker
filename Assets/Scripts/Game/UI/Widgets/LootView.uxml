<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="LootItem" src="LootItem.uxml" />
    <ui:VisualElement class="loot" picking-mode="Ignore">
        <ui:VisualElement name="loot-items" class="loot" picking-mode="Ignore">
            <ui:Instance template="LootItem" name="loot-item-template" />
        </ui:VisualElement>
        <ui:Label name="loot-suffix" class="nowrap" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
