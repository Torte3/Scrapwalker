    Talks:
    - Cue: 7
      Delay: 1
      Lines:
      - Face: 1
        Text: "\u3064\u3044\u306B\u96E2\u9678\u30E2\u30B8\u30E5\u30FC\u30EB\u306E\u4FEE\u7406\u304C\u5B8C\u4E86\u3057\u307E\u3057\u305F\u3002"
      - Face: 1
        Text: "\u3053\u306E\u661F\u304B\u3089\u306E\u8131\u51FA\u30B7\u30FC\u30B1\u30F3\u30B9\u3092\n\u5B9F\u884C\u3067\u304D\u308B\u3088\u3046\u306B\u306A\u308A\u307E\u3057\u305F\u3002"
      - Face: 0
        Text: "\u884C\u304D\u5148\u304B\u3089\u8131\u51FA\u3092\u9078\u3093\u3067\u3044\u305F\u3060\u3051\u308C\u3070\u5B9F\u884C\u3057\u307E\u3059\u3002"
      - Face: 0
        Text: "\u305F\u3060\u3001\u8131\u51FA\u306E\u969B\u306B\u306F\u30A8\u30CD\u30EB\u30AE\u30FC\u5145\u586B\u306E\u305F\u3081\n\u3057\u3070\u3089\u304F\u6642\u9593\u304C\u304B\u304B\u308A\u307E\u3059\u3002"
      - Face: 0
        Text: "\u305D\u306E\u969B\u306B\u6B8B\u7559\u6A5F\u5175\u304C\u96C6\u307E\u3063\u3066\u304F\u308B\u53EF\u80FD\u6027\u3082\u3042\u308B\u306E\u3067\u3001\n\u6E96\u5099\u306F\u4E07\u5168\u306B\u3057\u3066\u304A\u304F\u3053\u3068\u3092\u63A8\u5968\u3057\u307E\u3059\u3002"
